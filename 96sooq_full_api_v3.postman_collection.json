                                    "key": "folder",
                                    "value": "uploads",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/storage/upload",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "storage",
                                "upload"
                            ]
                        },
                        "description": "Upload a file to S3 storage."
                    },
                    "response": []
                }
            ]
        }
