                        "url": {
                            "raw": "{{base_url}}/api/subscriptions/ad-prices",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "subscriptions",
                                "ad-prices"
                            ]
                        },
                        "description": "Get prices for ad boosting plans."
                    },
                    "response": []
                },
                {
                    "name": "Boost Listing",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"listing_id\": \"{{listing_id}}\",\n  \"user_id\": \"{{user_id}}\",\n  \"name\": \"Boost Land Cruiser\",\n  \"type\": \"product_listing\",\n  \"plan_id\": \"{{plan_id}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/banners/boost",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "banners",
                                "boost"
                            ]
                        },
                        "description": "Boost an existing listing."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "7. Admin Management",
            "description": "Admin approval workflows.",
            "item": [
                {
                    "name": "List Pending Listings",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/admin/listings/?status=pending_approval",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "listings",
                                ""
                            ],
                            "query": [
                                {
                                    "key": "status",
                                    "value": "pending_approval"
                                }
                            ]
                        },
                        "description": "List listings waiting for approval."
                    },
                    "response": []
                },
                {
                    "name": "Approve Listing",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/admin/listings/{{listing_id}}/approve",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "listings",
                                "{{listing_id}}",
                                "approve"
                            ]
                        },
                        "description": "Approve a listing to make it Active."
                    },
                    "response": []
                },
                {
                    "name": "Create Category",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name_en\": \"Electronics\",\n  \"name_ar\": \"إلكترونيات\",\n  \"is_active\": true\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/admin/categories/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "categories",
                                ""
                            ]
                        },
                        "description": "Create a new category."
                    },
                    "response": []
                }
            ]
